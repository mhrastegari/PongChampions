# Copy to .env.local for local overrides. Never put secrets here: every VITE_ value ships to the browser.

# Absolute API origin for production builds hosted separately from the API, e.g. https://api.example.com.
# Leave empty when the client is served from the same origin as the API (or through the dev proxy).
VITE_API_BASE_URL=

# Development proxy target. Use http://localhost:5051 with the API's http launch profile.
VITE_DEV_PROXY_TARGET=https://localhost:7273
